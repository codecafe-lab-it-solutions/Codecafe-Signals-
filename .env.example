# LLM API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=your_gemini_api_key_here

# Trading Configuration
YO_SYMBOLS=XAUUSD,XAGUSD,USOUSD,SPX500
DB_PATH=trades.db
TRADING_MODE=paper
RISK_PCT=1.0
MAX_DAILY_LOSS_PCT=3.0
MAX_OPEN_POSITIONS=3

# Dashboard & Authentication
ADMIN_USER=admin
ADMIN_PASSWORD=change_this_admin_password
DEMO_USER=demo
DEMO_PASSWORD=change_this_demo_password
SECRET_KEY=generate_a_secure_random_hex_string
PORT=8780

# Optional Telegram alerts: create a bot with @BotFather, send it a message, then read your chat id
# from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
